---
import Base from '../layouts/Base.astro';
import { INSTALL_FREE_URL } from '../consts';

interface TermLine {
  type: 'user' | 'tool' | 'err' | 'done';
  b?: string;
  s?: string;
  text?: string;
}
interface Point { h: string; d: string }
interface AbilityCard { n: string; tag: string; h: string; d: string; chips: string[] }

interface Props {
  title: string;
  description: string;
  label: string;
  heading: string;
  lede: string;
  fine: string;
  termHost: string;
  termLines: TermLine[];
  termAria: string;
  whyLabel: string;
  whyHeading: string;
  points: Point[];
  cardsHeading: string;
  cardsLede: string;
  cards: AbilityCard[];
  closerHeading: string;
  closerLede: string;
}

const p = Astro.props;
---

<Base title={p.title} description={p.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="sec-label">{p.label}</p>
        <h1 set:html={p.heading} />
        <p class="lede">{p.lede}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={INSTALL_FREE_URL} rel="noopener">Get the free plugin</a>
          <a class="btn" href="/docs.html">Read the docs</a>
        </div>
        <p class="hero-fine mono">{p.fine}</p>
      </div>

      <div class="terminal rv" role="img" aria-label={p.termAria}>
        <div class="t-bar"><i></i><i></i><i></i><span>{p.termHost}</span></div>
        <div class="t-body">
          {p.termLines.map((l) =>
            l.type === 'user' ? <p class="t-user">{l.text}</p>
            : l.type === 'done' ? <p class="t-done">{l.text}</p>
            : l.type === 'err' ? <p class="t-err">{l.text}</p>
            : <p class="t-tool"><b>{l.b}</b> <span>{l.s}</span></p>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="problem">
    <div class="wrap">
      <p class="sec-label rv">{p.whyLabel}</p>
      <h2 class="rv">{p.whyHeading}</h2>
      <div class="steps">
        {p.points.map((pt, i) => (
          <div class="step rv">
            <span class="s-n mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{pt.h}</h3>
            <p>{pt.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="paper">
    <div class="wrap">
      <p class="sec-label rv">What the agent can actually do</p>
      <h2 class="rv">{p.cardsHeading}</h2>
      <p class="lede-dim rv">{p.cardsLede}</p>
      <div class="ability-grid">
        {p.cards.map((c) => (
          <div class="card rv">
            <p class="ag-head mono">{c.n} / <b>{c.tag}</b></p>
            <h3>{c.h}</h3>
            <p>{c.d}</p>
            <div class="ag-chips">
              {c.chips.map((chip) => <span class="chip">{chip}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="closer">
    <div class="wrap rv" style="text-align:center">
      <h2 set:html={p.closerHeading} />
      <p class="lede-dim closer-lede">{p.closerLede}</p>
      <div class="hero-ctas" style="justify-content:center">
        <a class="btn btn-primary" href={INSTALL_FREE_URL} rel="noopener">Get the free plugin</a>
        <a class="btn" href="/docs.html">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 90px 0 60px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero :global(.mark) { color: var(--accent); }
  .lede { color: var(--ink-dim); font-size: 1.14rem; margin: 22px 0 30px; }
  .lede-dim { color: inherit; opacity: 0.75; font-size: 1.08rem; margin: 16px 0 26px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-fine { margin-top: 22px; font-size: 0.78rem; color: var(--ink-faint); }

  .terminal {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #080b10;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(34, 211, 238, 0.06);
    overflow: hidden;
    transform: rotate(0.6deg);
  }
  .t-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-raise);
  }
  .t-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .t-bar i:first-child { background: var(--accent-deep); }
  .t-bar span {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .t-body { padding: 22px; display: grid; gap: 13px; }
  .t-body p { font-family: var(--font-mono); font-size: 0.84rem; line-height: 1.5; max-width: none; }
  .t-user { color: var(--ink); }
  .t-tool { color: var(--ink-faint); padding-left: 14px; }
  .t-tool b { color: var(--accent); font-weight: 600; }
  .t-tool span { color: var(--ink-dim); }
  .t-done { color: var(--good); }
  .t-err { color: #ff7b72; padding-left: 14px; }

  .problem { padding-top: 46px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 44px; }
  .s-n { color: var(--accent); font-size: 0.8rem; letter-spacing: 0.15em; }
  .step h3 { margin: 10px 0 8px; }
  .step p { color: var(--ink-dim); font-size: 0.98rem; }

  .ability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 40px;
  }
  .ag-head {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin-bottom: 10px;
  }
  .ag-head b { color: var(--accent-deep); font-weight: 600; }
  .ability-grid h3 { margin-bottom: 8px; }
  .ability-grid .card p { font-size: 0.95rem; color: var(--paper-dim); }
  .ag-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }

  .closer { padding: 110px 0; }
  .closer-lede { max-width: 56ch; margin: 18px auto 26px; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; }
    .terminal { transform: none; }
    .steps, .ability-grid { grid-template-columns: 1fr; }
  }
</style>
