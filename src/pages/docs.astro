---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order
);
const sections = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      id: entry.id.replace(/^\d+-/, ''),
      title: entry.data.title,
      Content,
    };
  })
);
---

<Base
  title="Documentation: WP MCP, the undoable MCP plugin for WordPress"
  description="Everything WP MCP does and exactly how the safety net works: getting started, connecting MCP clients, the safety model, the full tools reference, free vs Pro, and WooCommerce."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="sec-label">Documentation</p>
      <h1>Everything WP MCP does, and exactly how the safety net works.</h1>
      <p class="lede">
        WP MCP is the open-source plugin <code>wpmcp</code>, built on the
        official WordPress Abilities API. This section is for developers,
        agencies, and anyone connecting an AI client over MCP.
      </p>
    </div>
  </section>

  <div class="wrap docs-grid">
    <nav class="toc" aria-label="Documentation contents">
      <p class="toc-label mono">Contents</p>
      {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
    <div class="docs-body">
      {sections.map((s) => (
        <section class="doc-section" id={s.id}>
          <div class="prose">
            <s.Content />
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-hero { padding: 90px 0 30px; }
  .lede { color: var(--ink-dim); font-size: 1.14rem; margin: 22px 0 0; }

  .docs-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
    padding-bottom: 80px;
  }
  .toc {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--line);
    padding-left: 18px;
  }
  .toc-label {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }
  .toc a {
    color: var(--ink-dim);
    font-size: 0.92rem;
    padding: 5px 0;
  }
  .toc a:hover { color: var(--ink); text-decoration: none; }

  .doc-section { padding: 28px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .doc-section:last-child { border-bottom: none; }
  .docs-body :global(h1) {
    font-size: 1.9rem;
    margin-bottom: 0.6em;
  }

  @media (max-width: 880px) {
    .docs-grid { grid-template-columns: 1fr; }
    .toc { position: static; flex-direction: row; flex-wrap: wrap; gap: 10px 18px; border-left: none; padding-left: 0; }
  }
</style>
