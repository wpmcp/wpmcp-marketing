</Base>

<style>
  .page-hero { padding: 90px 0 20px; }
  .lede { color: var(--ink-dim); font-size: 1.14rem; margin: 22px 0 18px; }
  .hero-fine { font-size: 0.78rem; color: var(--ink-faint); }
  .legal { padding-top: 40px; }
</style>
